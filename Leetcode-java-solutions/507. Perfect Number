class Solution{
    public boolean checkPerfectNumber(int num){
        int x=num;
        int sum=0;
        if(num==1){
            return false;
        }
        for(int i=1;i<=Math.sqrt(num);i++){
            if((num%i==0)){
                // means i is a factor...
                sum+=i;      
                if(((num/i)!=i) && (num/i)!=num){
                    sum+=(num/i);
                }
            }
        }
        if(sum==x){
            return true;
        }
        return false;
    }
}